<view class="page">
  <view class="summary">
    <text class="eyebrow">协议隐私</text>
    <text class="title">用户服务协议与隐私政策</text>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{loading}}" class="card page-loading">加载中</view>

  <view wx:if="{{protocols}}" class="card protocol-card">
    <view wx:for="{{protocolItems}}" wx:key="protocolType" class="protocol-document">
      <text class="status protocol-title">{{item.title}}</text>
      <text class="meta">版本 {{item.versionNo}} · 更新于 {{item.updatedAt}}</text>
      <view wx:for="{{item.sections}}" wx:for-item="section" wx:key="heading" class="protocol-section">
        <text class="protocol-heading">{{section.heading}}</text>
        <text wx:for="{{section.paragraphs}}" wx:for-item="paragraph" wx:key="*this" class="protocol-paragraph">{{paragraph}}</text>
      </view>
    </view>

    <view wx:if="{{canAgree}}" class="protocol-consent">
      <checkbox-group bindchange="toggleAgreement" data-field="userAgreementChecked">
        <label class="agreement-choice">
          <checkbox value="agreed" checked="{{userAgreementChecked}}" />
          <text>我已阅读并同意《嘉音用户服务协议》</text>
        </label>
      </checkbox-group>
      <checkbox-group bindchange="toggleAgreement" data-field="privacyPolicyChecked">
        <label class="agreement-choice">
          <checkbox value="agreed" checked="{{privacyPolicyChecked}}" />
          <text>我已阅读并同意《嘉音隐私政策》</text>
        </label>
      </checkbox-group>
      <button class="primary" bindtap="agreeAll" loading="{{submitting}}" disabled="{{submitting || !userAgreementChecked || !privacyPolicyChecked}}">同意并继续</button>
      <button class="secondary" bindtap="declineAndExit" disabled="{{submitting}}">暂不同意并退出</button>
    </view>
    <text wx:else class="meta read-only-hint">当前为阅读模式。登录后由您分别选择是否同意。</text>
  </view>
</view>
