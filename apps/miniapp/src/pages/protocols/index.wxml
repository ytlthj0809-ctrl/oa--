<view class="page">
  <view class="summary">
    <text class="eyebrow">协议隐私</text>
    <text class="title">用户服务协议与隐私政策</text>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{loading}}" class="card page-loading">加载中</view>

  <view wx:if="{{protocols}}" class="card">
    <view wx:if="{{protocols.userAgreement}}" class="list-item">
      <text class="status">{{protocols.userAgreement.title}}</text>
      <text class="meta">版本 {{protocols.userAgreement.versionNo}}</text>
      <text>{{protocols.userAgreement.content}}</text>
      <checkbox-group bindchange="toggleProtocol" data-type="userAgreement"><label class="checkbox-line"><checkbox value="checked" /> <text>我已阅读并同意用户服务协议</text></label></checkbox-group>
    </view>
    <view wx:if="{{protocols.privacyPolicy}}" class="list-item">
      <text class="status">{{protocols.privacyPolicy.title}}</text>
      <text class="meta">版本 {{protocols.privacyPolicy.versionNo}}</text>
      <text>{{protocols.privacyPolicy.content}}</text>
      <checkbox-group bindchange="toggleProtocol" data-type="privacyPolicy"><label class="checkbox-line"><checkbox value="checked" /> <text>我已阅读并同意隐私政策</text></label></checkbox-group>
    </view>
    <button class="primary" bindtap="agreeAll" loading="{{submitting}}" disabled="{{submitting || !checked.userAgreement || !checked.privacyPolicy}}">同意并继续</button>
  </view>
</view>
