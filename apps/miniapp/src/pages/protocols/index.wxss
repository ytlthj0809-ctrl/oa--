.protocol-card {
  display: grid;
  gap: 28rpx;
}

.protocol-document {
  min-width: 0;
}

.protocol-document + .protocol-document {
  border-top: 1rpx solid #e4e7ec;
  padding-top: 28rpx;
}

.protocol-title {
  color: #231815;
  display: block;
  font-size: 30rpx;
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.protocol-section {
  margin-top: 24rpx;
}

.protocol-heading {
  color: #231815;
  display: block;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.55;
  margin-bottom: 10rpx;
}

.protocol-paragraph {
  color: #475467;
  display: block;
  font-size: 24rpx;
  line-height: 1.75;
  margin-bottom: 12rpx;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}

.protocol-consent {
  border-top: 1rpx solid #e4e7ec;
  display: grid;
  gap: 18rpx;
  padding-top: 28rpx;
}

.agreement-choice {
  align-items: flex-start;
  background: #fffdf3;
  border: 1rpx solid #e4e7ec;
  border-radius: 14rpx;
  color: #231815;
  display: flex;
  font-size: 24rpx;
  gap: 12rpx;
  line-height: 1.55;
  min-height: 76rpx;
  padding: 18rpx;
}

.agreement-choice checkbox {
  flex: 0 0 auto;
}

.protocol-consent button {
  width: 100%;
}

.read-only-hint {
  border-top: 1rpx solid #e4e7ec;
  line-height: 1.55;
  padding-top: 24rpx;
}
