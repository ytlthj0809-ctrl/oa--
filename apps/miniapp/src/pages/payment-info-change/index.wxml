<view class="page">
  <view class="summary">
    <text class="eyebrow">打款信息</text>
    <text class="title">修改申请</text>
  </view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view class="notice">修改收款资料会进入后台审核，审核通过前仍以当前已生效资料为准。</view>
  <view class="card">
    <label class="field"><text>姓名</text><input value="{{form.realName}}" data-field="realName" bindinput="updateField" /></label>
    <label class="field"><text>身份证号</text><input type="idcard" maxlength="18" value="{{form.idCardNo}}" data-field="idCardNo" bindinput="updateField" placeholder="请输入 18 位身份证号" /></label>
    <label class="field"><text>手机号</text><input type="number" maxlength="11" value="{{form.paymentMobile}}" data-field="paymentMobile" bindinput="updateField" placeholder="请输入收款手机号" /></label>
    <label class="field"><text>银行卡号</text><input type="number" maxlength="19" value="{{form.bankCardNo}}" data-field="bankCardNo" bindinput="updateField" placeholder="请输入本人银行卡号" /></label>
    <label class="field"><text>修改原因</text><textarea value="{{form.modifyReason}}" data-field="modifyReason" bindinput="updateField" /></label>
    <button class="primary" bindtap="submitChange" loading="{{submitting}}" disabled="{{submitting}}">提交申请</button>
  </view>
  <view wx:if="{{result}}" class="card">
    <text class="row-title">{{result.changeRequestId || result.requestId}}</text>
    <text class="badge {{result.reviewStatusTone}}">{{result.reviewStatusText}}</text>
    <text class="helper-text">修改申请已提交，请等待后台审核。审核通过后以新资料为准。</text>
  </view>
</view>
