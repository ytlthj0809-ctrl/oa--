<view class="page" data-q70-miniapp-profile-page="true">
  <view class="summary">
    <view>
      <text class="eyebrow">我的</text>
      <text class="title">{{profile.displayName || '本地主播'}}</text>
    </view>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{loading}}" class="card page-loading">加载中</view>

  <view wx:if="{{profile}}" class="card">
    <view class="grid">
      <view class="metric">
        <text class="label">主播状态</text>
        <text class="badge {{profile.anchorStatusTone}}">{{profile.anchorStatusText}}</text>
      </view>
      <view class="metric">
        <text class="label">签约状态</text>
        <text class="badge {{profile.signStatusTone}}">{{profile.signStatusText}}</text>
      </view>
      <view class="metric">
        <text class="label">手机号</text>
        <text>{{profile.mobileMasked}}</text>
      </view>
      <view class="metric">
        <text class="label">平台账号</text>
        <text>{{profile.platformAccountCount}}</text>
      </view>
    </view>
  </view>

  <view class="card action-section">
    <text class="label">提现必备</text>
    <view class="actions">
      <button class="secondary" bindtap="goPage" data-page="payment-info">打款信息</button>
      <button class="secondary" bindtap="goPage" data-page="sign">云账户签约</button>
      <button class="secondary" bindtap="goPage" data-page="platform-accounts">平台账号</button>
    </view>
  </view>

  <view class="card action-section">
    <text class="label">账号资料</text>
    <view class="actions">
      <button class="secondary" bindtap="goPage" data-page="profile-detail">个人资料</button>
      <button class="secondary" bindtap="goPage" data-page="notifications">通知中心</button>
      <button class="secondary" bindtap="goPage" data-page="protocols">协议隐私</button>
    </view>
  </view>

  <view class="card action-section">
    <text class="label">帮助设置</text>
    <view class="actions">
      <button class="secondary" bindtap="goPage" data-page="contact">联系客服</button>
      <button class="secondary" bindtap="goPage" data-page="settings">设置</button>
    </view>
  </view>

  <view wx:if="{{protocols && (protocols.userAgreement || protocols.privacyPolicy)}}" class="card">
    <text class="label">协议与隐私</text>
    <view wx:if="{{protocols.userAgreement}}" class="list-item">
      <text>{{protocols.userAgreement.title}} {{protocols.userAgreement.versionNo}}</text>
      <button class="secondary" bindtap="agreeProtocol" data-type="{{protocols.userAgreement.protocolType}}" data-version="{{protocols.userAgreement.versionNo}}" loading="{{agreeingProtocolType === protocols.userAgreement.protocolType}}" disabled="{{protocols.userAgreement.agreed || agreeingProtocolType}}">{{protocols.userAgreement.agreed ? '已同意' : '同意'}}</button>
    </view>
    <view wx:if="{{protocols.privacyPolicy}}" class="list-item">
      <text>{{protocols.privacyPolicy.title}} {{protocols.privacyPolicy.versionNo}}</text>
      <button class="secondary" bindtap="agreeProtocol" data-type="{{protocols.privacyPolicy.protocolType}}" data-version="{{protocols.privacyPolicy.versionNo}}" loading="{{agreeingProtocolType === protocols.privacyPolicy.protocolType}}" disabled="{{protocols.privacyPolicy.agreed || agreeingProtocolType}}">{{protocols.privacyPolicy.agreed ? '已同意' : '同意'}}</button>
    </view>
  </view>

  <view wx:if="{{contact}}" class="card">
    <text class="label">联系客服</text>
    <text>{{contact.phone}} · {{contact.wechat}}</text>
    <text class="meta">{{contact.workTime}}</text>
  </view>

</view>
