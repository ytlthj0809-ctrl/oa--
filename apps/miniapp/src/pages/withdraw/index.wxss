@import "../../styles/common.wxss";

.summary,
.record,
.detail {
  background: #ffffff;
  border: 1rpx solid #d9dee8;
  border-top: 8rpx solid #ffda01;
  border-radius: 16rpx;
  box-shadow: 0 14rpx 34rpx rgba(35, 24, 21, 0.08);
  min-width: 0;
}

.summary {
  align-items: center;
  display: flex;
  gap: 18rpx;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 24rpx;
}

.eyebrow,
.label,
.timeline-reason {
  color: #667085;
  display: block;
  font-size: 24rpx;
}

.title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  margin-top: 8rpx;
}

.primary,
.secondary {
  align-items: center;
  display: flex;
  font-weight: 700;
  justify-content: center;
  line-height: 1.25;
  min-height: 76rpx;
  min-width: 0;
  padding: 0 20rpx;
  white-space: normal;
}

.primary::after,
.secondary::after,
button::after {
  border: 0;
}

.primary {
  background: #ffda01;
  border-radius: 14rpx;
  box-shadow: 0 8rpx 18rpx rgba(255, 218, 1, 0.22);
  color: #231815;
  font-size: 26rpx;
}

.secondary {
  background: #eef2f6;
  border-radius: 14rpx;
  color: #231815;
  font-size: 24rpx;
}

.small {
  min-height: 52rpx;
  padding: 0 20rpx;
}

.error {
  align-items: center;
  background: #fbe9e7;
  border: 1rpx solid #f2b8b0;
  border-radius: 14rpx;
  color: #b5473b;
  display: flex;
  gap: 16rpx;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 18rpx;
}

.error text {
  flex: 1;
  overflow-wrap: anywhere;
}

.state-card {
  background: #ffffff;
  border: 1rpx solid #d9dee8;
  border-radius: 16rpx;
  box-shadow: 0 10rpx 28rpx rgba(31, 45, 61, 0.06);
  color: #667085;
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
  min-height: 112rpx;
  padding: 28rpx;
  text-align: center;
}

.rule-card {
  background: #ffffff;
  border: 1rpx solid #d9dee8;
  border-top: 8rpx solid #ffda01;
  border-radius: 16rpx;
  box-shadow: 0 14rpx 34rpx rgba(35, 24, 21, 0.08);
  margin-bottom: 20rpx;
  min-width: 0;
  padding: 24rpx;
}

.rule-head {
  align-items: flex-start;
  display: flex;
  gap: 16rpx;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.rule-head .small {
  flex: 0 0 auto;
  min-width: 132rpx;
}

.rule-grid {
  display: grid;
  gap: 14rpx;
  grid-template-columns: 1fr 1fr;
  margin-bottom: 16rpx;
}

.rule-item {
  background: #fffdf3;
  border: 1rpx solid #e4e7ec;
  border-radius: 14rpx;
  min-height: 104rpx;
  padding: 16rpx;
}

.rule-item text {
  display: block;
  overflow-wrap: anywhere;
}

.rule-value {
  color: #231815;
  font-size: 28rpx;
  font-weight: 700;
  margin-top: 6rpx;
}

.rule-list {
  background: #fff8cf;
  border: 1rpx solid #f2df7a;
  border-radius: 14rpx;
  color: #231815;
  display: grid;
  font-size: 24rpx;
  gap: 10rpx;
  line-height: 1.55;
  padding: 18rpx;
}

.rule-list text {
  display: block;
  overflow-wrap: anywhere;
}

.loading-state {
  color: #231815;
}

.empty-state {
  background: #fbfcfd;
  border-color: #cbd5dc;
  border-style: dashed;
  color: #667085;
}

.amount-feedback {
  display: block;
  font-size: 24rpx;
  line-height: 1.45;
  margin-top: -4rpx;
}

.withdraw-balance {
  border-bottom: 1rpx solid #e4e7ec;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
}

.balance-value {
  color: #231815;
  display: block;
  font-size: 54rpx;
  font-weight: 800;
  letter-spacing: 0;
  margin-top: 8rpx;
}

.balance-subline,
.recent-records-caption,
.record-reference {
  color: #667085;
  display: block;
  font-size: 22rpx;
  line-height: 1.45;
  margin-top: 6rpx;
  overflow-wrap: anywhere;
}

.payment-destination {
  align-items: flex-start;
  display: flex;
  gap: 16rpx;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.destination-value {
  color: #231815;
  display: block;
  font-size: 27rpx;
  font-weight: 700;
  margin-top: 8rpx;
}

.prerequisite-statuses {
  align-items: flex-end;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.recent-records-head {
  align-items: center;
  display: flex;
  gap: 16rpx;
  justify-content: space-between;
  margin: 28rpx 0 16rpx;
}

.recent-records-title {
  color: #231815;
  display: block;
  font-size: 30rpx;
  font-weight: 800;
}

.recent-records-head .recent-records-caption {
  color: #667085;
}

.amount-feedback.success {
  color: #1d7f5d;
}

.amount-feedback.danger {
  color: #d92d20;
}

.amount-feedback.neutral {
  color: #667085;
}

.withdraw-rule-summary {
  display: grid;
  gap: 10rpx;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin: 6rpx 0 2rpx;
}

.rule-summary-item {
  background: #fff8cf;
  border: 1rpx solid #f2df7a;
  border-radius: 999rpx;
  color: #6b5600;
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.25;
  overflow-wrap: anywhere;
  padding: 12rpx 10rpx;
  text-align: center;
}

.summary-label,
.summary-value {
  display: block;
}

.summary-label {
  color: #8a6a00;
  font-size: 20rpx;
  margin-bottom: 4rpx;
}

.summary-value {
  color: #4a3b00;
}

.window-hint {
  border-radius: 14rpx;
  display: grid;
  font-size: 24rpx;
  font-weight: 700;
  gap: 6rpx;
  line-height: 1.45;
  padding: 14rpx 18rpx;
}

.window-countdown {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  opacity: 0.78;
}

.window-hint.success {
  background: #e8f6ef;
  color: #1d7f5d;
}

.window-hint.warning {
  background: #fff8cf;
  color: #8a6a00;
}

.field-head {
  align-items: center;
  display: flex;
  gap: 12rpx;
  justify-content: space-between;
}

.field-head text {
  color: #231815;
  font-size: 26rpx;
  font-weight: 700;
}

.inline-action {
  background: #fff8cf;
  border-radius: 999rpx;
  color: #6f5200;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.2;
  margin: 0;
  min-height: 48rpx;
  padding: 0 18rpx;
}

.inline-action::after {
  border: 0;
}

.record-list {
  display: grid;
  gap: 16rpx;
}

.record {
  box-shadow: 0 1rpx 0 rgba(35, 24, 21, 0.03);
  padding: 22rpx;
}

.record-id {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  overflow-wrap: anywhere;
}

.record-status {
  display: block;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.record-status.success {
  color: #1d7f5d;
}

.record-status.pending {
  color: #b54708;
}

.record-status.danger {
  color: #d92d20;
}

.record-status.neutral {
  color: #667085;
}

.record-meta {
  color: #667085;
  display: flex;
  font-size: 24rpx;
  gap: 20rpx;
  margin-top: 14rpx;
}

.detail {
  margin-top: 22rpx;
  padding: 22rpx;
}

.detail-head {
  border-bottom: 1rpx solid #d9dee8;
  margin-bottom: 18rpx;
  padding-bottom: 18rpx;
}

.detail-grid {
  display: grid;
  gap: 14rpx;
  grid-template-columns: 1fr 1fr;
}

.detail-grid text {
  display: block;
  font-size: 25rpx;
}

.timeline {
  border-top: 1rpx solid #d9dee8;
  display: grid;
  gap: 12rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
}

.timeline-item {
  border-left: 6rpx solid #ffda01;
  padding-left: 14rpx;
}
