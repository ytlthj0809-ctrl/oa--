<view class="page" data-q41-miniapp-withdraw-page="true">
  <view class="summary">
    <view>
      <text class="eyebrow">提现</text>
      <text class="title">提交提现申请</text>
    </view>
  </view>

  <view wx:if="{{error}}" class="error">
    <text>{{error}}</text>
    <button class="secondary small" bindtap="retryLoad">{{errorSource === 'submit-uncertain' ? '查询提交结果' : errorSource === 'submit' ? '重新检查' : '重新加载'}}</button>
  </view>
  <view wx:if="{{successText}}" class="success-card">{{successText}}</view>

  <view class="card">
    <view class="withdraw-balance">
      <text class="label">可提现余额</text>
      <text class="balance-value">{{home.availableBalanceText || '加载中'}}</text>
      <text class="balance-subline">冻结余额 {{home.frozenBalanceText || '-'}}</text>
    </view>
    <view class="payment-destination">
      <view>
        <text class="label">收款银行卡</text>
        <text class="destination-value">{{home.paymentInfoSummary.bankCardNoMasked || '打款信息生效后显示'}}</text>
      </view>
      <view class="prerequisite-statuses">
        <text class="badge {{home.paymentInfoStatusTone || 'neutral'}}">打款信息 {{home.paymentInfoStatusText || '-'}}</text>
        <text class="badge {{home.signStatusTone || 'neutral'}}">签约 {{home.signStatusText || '-'}}</text>
      </view>
    </view>
    <label class="field">
      <view class="field-head">
        <text>提现金额</text>
        <button class="inline-action enhanced" bindtap="fillFullAmount" disabled="{{submitting || submitResultUncertain}}">全部提现</button>
      </view>
      <input type="digit" value="{{amountYuan}}" bindinput="updateAmount" disabled="{{submitting || submitResultUncertain}}" placeholder="请输入金额，单位元" />
    </label>
    <text wx:if="{{amountFeedbackText}}" class="amount-feedback {{amountFeedbackTone}}">{{amountFeedbackText}}</text>
    <view class="withdraw-rule-summary">
      <view wx:for="{{withdrawRuleSummaryItems}}" wx:key="key" class="rule-summary-item">
        <text class="summary-label">{{item.label}}</text>
        <text class="summary-value">{{item.value}}</text>
      </view>
    </view>
    <view wx:if="{{submitWindowStatusText}}" class="window-hint {{submitWindowTone}}">
      <text>{{submitWindowStatusText}}</text>
      <text wx:if="{{submitWindowCountdownText}}" class="window-countdown">{{submitWindowCountdownText}}</text>
    </view>
    <view class="actions">
      <button class="primary" bindtap="submitWithdraw" loading="{{submitting}}" disabled="{{submitting || submitResultUncertain || !canSubmitAmount || !submitWindowOpen}}">{{submitResultUncertain ? '正在确认上次提交' : '提交提现'}}</button>
    </view>
  </view>

  <view class="rule-card" data-q121-miniapp-withdraw-rules="visible">
    <view class="rule-head" bindtap="toggleRules">
      <view>
        <text class="eyebrow">提现规则</text>
        <text class="title">额度、次数、时间和到账说明</text>
      </view>
      <text class="collapse-toggle">{{rulesExpanded ? '收起' : '查看规则'}}</text>
    </view>
    <view wx:if="{{rulesExpanded}}">
      <view class="rule-grid">
        <view class="rule-item">
          <text class="label">可提现额度</text>
          <text class="rule-value">{{home.availableBalanceText || '加载中'}}</text>
        </view>
        <view class="rule-item">
          <text class="label">每日提现次数</text>
          <text class="rule-value">{{dailyRemainText}}</text>
        </view>
        <view class="rule-item">
          <text class="label">提现时间</text>
          <text>{{submitWindowText}}</text>
        </view>
        <view class="rule-item">
          <text class="label">到账时间</text>
          <text>{{arrivalText}}</text>
        </view>
      </view>
      <view class="rule-list">
        <text>单笔限额：{{withdrawRuleSnapshot.amountRangeText}}</text>
        <text>手续费：{{withdrawRuleSnapshot.feeText}}</text>
        <text>余额冻结：{{withdrawRuleSnapshot.frozenText}}</text>
        <text>审核流程：{{withdrawRuleSnapshot.auditText}}</text>
        <text>异常限制：{{withdrawRuleSnapshot.exceptionText}}</text>
      </view>
    </view>
    <view wx:if="{{!rulesExpanded}}" class="actions">
      <button class="secondary small" bindtap="openGuide">查看完整规则</button>
    </view>
  </view>

  <view class="recent-records-head">
    <view>
      <text class="recent-records-title">最近提现</text>
      <text class="recent-records-caption">仅显示最近 3 条</text>
    </view>
    <button class="inline-action" bindtap="openRecords">全部记录</button>
  </view>

  <view wx:if="{{loadingList}}" class="state-card loading-state page-loading">加载中</view>
  <view wx:elif="{{recentRecords.length === 0}}" class="state-card empty-state empty">{{emptyText}}</view>

  <view wx:else class="record-list">
    <view wx:for="{{recentRecords}}" wx:key="applyId" class="record arrow-right row-clickable" hover-class="tap-target-hover" bindtap="openDetail" data-apply-id="{{item.applyId}}">
      <view>
        <text class="record-id">{{item.amountText}}</text>
        <text class="record-reference">申请编号 {{item.applyId}}</text>
        <text class="record-status {{item.statusTone || 'neutral'}}">{{item.statusText}}</text>
      </view>
      <view class="record-meta">
        <text>{{item.createdAtText || item.progressText}}</text>
      </view>
    </view>
  </view>

</view>
