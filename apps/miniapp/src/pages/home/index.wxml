<view class="page" data-q70-miniapp-home-page="true">
  <view class="summary">
    <text class="greeting">{{home.greetingText || ''}}</text>
    <text class="eyebrow">首页</text>
    <text class="title">余额与提现</text>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{loading}}" class="card page-loading">加载中</view>

  <view wx:if="{{home}}" class="card home-primary-card">
    <view class="hero-balance">
      <text class="label">可提现余额</text>
      <text class="value">{{home.availableBalanceText}}</text>
    </view>
    <text class="home-next-copy">{{home.nextAction.text}}</text>
    <button class="primary home-primary-action" bindtap="goNextAction">{{home.nextAction.buttonText || '继续'}}</button>
  </view>

  <view wx:if="{{home && !home.withdrawReady}}" class="card">
    <view class="section-head">
      <text class="label">提现五步</text>
      <text class="badge {{home.nextAction.tone}}">{{home.nextAction.buttonText || '继续'}}</text>
    </view>
    <view class="guide-list">
      <view
        wx:for="{{home.withdrawGuideSteps}}"
        wx:key="key"
        class="guide-step {{item.tone}} {{item.disabled ? 'disabled' : ''}}"
        bindtap="goGuideStep"
        data-page="{{item.page}}"
        data-disabled="{{item.disabled}}"
        data-disabled-text="{{item.disabledText}}"
      >
        <view class="guide-index">{{index + 1}}</view>
        <view class="guide-main">
          <text class="guide-title">{{item.title}}</text>
          <text class="guide-desc">{{item.description}}</text>
        </view>
        <view class="guide-action">
          <text class="badge {{item.tone}}">{{item.statusText}}</text>
          <text class="guide-link">{{item.buttonText}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{home}}" class="card">
    <view class="grid">
      <view class="metric">
        <text class="label">可用余额</text>
        <text class="value">{{home.availableBalanceText}}</text>
      </view>
      <view class="metric">
        <text class="label">冻结余额</text>
        <text class="value">{{home.frozenBalanceText}}</text>
      </view>
      <view class="metric">
        <text class="label">注册状态</text>
        <text class="badge {{home.registrationStatusTone}}">{{home.registrationStatusText}}</text>
      </view>
      <view class="metric">
        <text class="label">白名单状态</text>
        <text class="badge {{home.whitelistStatusTone}}">{{home.whitelistStatusText}}</text>
      </view>
      <view class="metric">
        <text class="label">签约状态</text>
        <text class="value">{{home.signStatusText}}</text>
      </view>
      <view class="metric">
        <text class="label">打款信息</text>
        <text class="value">{{home.paymentInfoStatusText}}</text>
      </view>
    </view>
    <view class="actions">
      <button class="secondary" bindtap="goPage" data-page="balance">查看余额流水</button>
      <button class="secondary" bindtap="goPage" data-page="withdraw-records">查看提现记录</button>
    </view>
  </view>
</view>
