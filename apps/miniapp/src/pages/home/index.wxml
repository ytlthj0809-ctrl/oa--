<view class="page" data-q70-miniapp-home-page="true">
  <view class="summary">
    <text class="greeting">{{home.greetingText || ''}}</text>
    <text class="eyebrow">首页</text>
    <text class="title">余额与今日数据</text>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{loading}}" class="card page-loading">加载中</view>

  <view wx:if="{{home}}" class="card">
    <view class="hero-balance">
      <text class="label">可提现余额</text>
      <text class="value">{{home.availableBalanceText}}</text>
    </view>
  </view>

  <view wx:if="{{home}}" class="card">
    <view class="section-head">
      <text class="label">提现三步</text>
      <text class="badge {{home.signStatusTone}}">{{home.nextAction.buttonText || '继续'}}</text>
    </view>
    <view class="guide-list">
      <view
        wx:for="{{home.withdrawGuideSteps}}"
        wx:key="key"
        class="guide-step {{item.tone}} {{item.disabled ? 'disabled' : ''}}"
        bindtap="goGuideStep"
        data-page="{{item.page}}"
        data-disabled="{{item.disabled}}"
        data-disabled-text="{{item.disabledText}}"
      >
        <view class="guide-index">{{index + 1}}</view>
        <view class="guide-main">
          <text class="guide-title">{{item.title}}</text>
          <text class="guide-desc">{{item.description}}</text>
        </view>
        <view class="guide-action">
          <text class="badge {{item.tone}}">{{item.statusText}}</text>
          <text class="guide-link">{{item.buttonText}}</text>
        </view>
      </view>
    </view>
    <text class="helper-text">{{home.nextAction.text}}</text>
    <button class="primary" bindtap="goNextAction">{{home.nextAction.buttonText || home.nextAction.text}}</button>
  </view>

  <view wx:if="{{home}}" class="card">
    <view class="grid" style="grid-template-columns: 1fr 1fr 1fr;">
      <view class="metric">
        <text class="label">冻结余额</text>
        <text class="value">{{home.frozenBalanceText}}</text>
      </view>
      <view class="metric" bindtap="goPage" data-page="rewards">
        <text class="label">任务奖励</text>
        <text class="value">{{home.rewardBalanceText}}</text>
      </view>
      <view class="metric" bindtap="goPage" data-page="notifications">
        <text class="label">未读通知</text>
        <text class="value">{{home.unreadNotificationCount}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{home}}" class="card">
    <view class="section-head" bindtap="toggleTodayData">
      <text class="label">今日数据</text>
      <text class="collapse-toggle">{{todayDataExpanded ? '收起' : '展开'}}</text>
    </view>
    <view wx:if="{{todayDataExpanded}}">
      <view class="grid">
        <view class="metric">
          <text class="label">流水</text>
          <text class="value">{{home.todayIncomeText}}</text>
        </view>
        <view class="metric">
          <text class="label">有效时长</text>
          <text class="value">{{home.todayMetrics.validDurationMinutes}} 分钟</text>
        </view>
        <view class="metric">
          <text class="label">有效天数</text>
          <text class="value">{{home.todayMetrics.validDays}}</text>
        </view>
        <view class="metric">
          <text class="label">签约状态</text>
          <text class="value">{{home.signStatusText}}</text>
        </view>
        <view class="metric">
          <text class="label">打款信息</text>
          <text class="value">{{home.paymentInfoStatusText}}</text>
        </view>
      </view>
    </view>
    <view class="actions">
      <button class="primary" bindtap="goPage" data-page="withdraw">提现</button>
      <button class="secondary" bindtap="goPage" data-page="withdraw-records">提现记录</button>
      <button class="secondary" bindtap="goPage" data-page="data">数据</button>
      <button class="secondary" bindtap="goPage" data-page="profile">我的</button>
    </view>
  </view>
</view>
