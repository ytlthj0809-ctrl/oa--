.page {
  background: linear-gradient(180deg, #231815 0rpx, #231815 248rpx, #f4f6f8 248rpx, #f4f6f8 100%);
  color: #231815;
  min-height: 100vh;
  padding: 28rpx 28rpx calc(36rpx + env(safe-area-inset-bottom));
}

.summary,
.form-card,
.result-card {
  background: #ffffff;
  border: 1rpx solid #d9dee8;
  border-top: 8rpx solid #ffda01;
  border-radius: 16rpx;
  box-shadow: 0 14rpx 34rpx rgba(35, 24, 21, 0.08);
  min-width: 0;
}

.summary {
  margin-bottom: 20rpx;
  padding: 24rpx;
}

.eyebrow {
  color: #667085;
  display: block;
  font-size: 24rpx;
}

.title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  margin-top: 8rpx;
}

.summary-desc {
  color: #667085;
  display: block;
  font-size: 24rpx;
  line-height: 1.45;
  margin-top: 10rpx;
}

.error {
  background: #fbe9e7;
  border: 1rpx solid #f2b8b0;
  border-radius: 14rpx;
  color: #b5473b;
  margin-bottom: 20rpx;
  overflow-wrap: anywhere;
  padding: 18rpx;
}

.form-card {
  display: grid;
  gap: 18rpx;
  padding: 24rpx;
}

.field {
  display: grid;
  gap: 8rpx;
}

.field text {
  color: #667085;
  font-size: 24rpx;
}

.field input {
  background: #ffffff;
  border: 1rpx solid #d9dee8;
  border-radius: 14rpx;
  min-height: 72rpx;
  padding: 0 18rpx;
}

.privacy-note {
  background: #fff8db;
  border: 1rpx solid #f4d33f;
  border-radius: 14rpx;
  color: #6e4c00;
  font-size: 24rpx;
  line-height: 1.5;
  padding: 18rpx;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.actions button {
  flex: 1 1 220rpx;
}

.primary,
.secondary {
  align-items: center;
  display: flex;
  font-weight: 700;
  justify-content: center;
  line-height: 1.25;
  min-height: 76rpx;
  min-width: 0;
  padding: 0 20rpx;
  white-space: normal;
}

.primary::after,
.secondary::after,
button::after {
  border: 0;
}

.primary {
  background: #ffda01;
  border-radius: 14rpx;
  box-shadow: 0 8rpx 18rpx rgba(255, 218, 1, 0.22);
  color: #231815;
  font-size: 26rpx;
}

.secondary {
  background: #eef2f6;
  border-radius: 14rpx;
  color: #231815;
  font-size: 26rpx;
}

.result-card {
  display: grid;
  gap: 8rpx;
  margin-top: 20rpx;
  padding: 22rpx;
}

.record-id {
  font-size: 28rpx;
  font-weight: 700;
  overflow-wrap: anywhere;
}

.record-status {
  color: #1d7f5d;
  font-size: 24rpx;
}

.result-line {
  color: #667085;
  font-size: 24rpx;
}

.hint {
  color: #667085;
  font-size: 24rpx;
}
