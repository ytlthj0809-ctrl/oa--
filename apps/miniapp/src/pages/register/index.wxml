<view class="page" data-q62-miniapp-registration-page="true">
  <view class="summary">
    <view>
      <text class="eyebrow">主播注册</text>
      <text class="title">新主播注册</text>
      <text class="summary-desc">{{sourceText}}</text>
    </view>
  </view>

  <view wx:if="{{error}}" class="error">
    <text>{{error}}</text>
  </view>

  <view class="form-card">
    <label class="field">
      <text>主播编号（公司分配）</text>
      <input value="{{form.anchorId}}" data-field="anchorId" bindinput="updateField" disabled="{{registrationLocked}}" placeholder="例如 A1001" />
    </label>
    <label class="field">
      <text>比心 ID</text>
      <input value="{{form.bixinAccountNo}}" data-field="bixinAccountNo" bindinput="updateField" disabled="{{registrationLocked}}" maxlength="128" placeholder="请输入比心平台中的 ID" />
      <text class="field-help">用于认领运营已上传的待注册白名单及注册前收入，必须与比心平台中的 ID 完全一致。</text>
    </label>
    <label class="field">
      <text>主播姓名</text>
      <input value="{{form.displayName}}" data-field="displayName" bindinput="updateField" disabled="{{registrationLocked}}" placeholder="请输入主播姓名或昵称" />
    </label>
    <label class="field">
      <text>手机号</text>
      <input value="{{form.mobile}}" data-field="mobile" bindinput="updateField" disabled="{{registrationLocked}}" type="number" maxlength="11" placeholder="请输入本人手机号" />
    </label>
    <view class="privacy-note">这里只填写基本身份信息。银行卡和身份证在提现前单独完善。</view>
    <checkbox-group class="field" bindchange="toggleProtocol">
      <text>协议确认</text>
      <view class="checkbox-line">
        <label class="checkbox-control">
          <checkbox value="agreed" checked="{{form.protocolChecked}}" disabled="{{registrationLocked}}" />
          <text>已阅读并同意</text>
        </label>
        <text class="hint protocol-link" catchtap="openProtocols">《用户服务协议》和《隐私政策》</text>
      </view>
    </checkbox-group>
    <view class="privacy-entry">
      <text>登录或提交资料前，请先阅读</text>
      <text class="privacy-link" bindtap="openPrivacyContract">《小程序用户隐私保护指引》</text>
    </view>
    <button class="primary submit-button" bindtap="submitRegistration" loading="{{submitting}}" disabled="{{submitting || registrationLocked || !canSubmit}}">{{registrationLocked ? '申请已提交' : '提交注册申请'}}</button>
    <view class="form-links">
      <text bindtap="goLogin">返回登录</text>
    </view>
  </view>

  <view wx:if="{{latestRequest}}" class="result-card">
    <text class="record-id">{{latestRequest.registrationId}}</text>
    <text class="badge {{latestRequest.reviewStatusTone}}">{{latestRequest.reviewStatusText}}</text>
    <text class="result-line">主播ID {{latestRequest.anchorId || '-'}} · 比心 ID {{latestRequest.bixinAccountNo || latestRequest.accountNo || '-'}} · {{latestRequest.mobile}}</text>
    <text class="helper-text">{{latestRequest.nextStepText}}</text>
  </view>
</view>
