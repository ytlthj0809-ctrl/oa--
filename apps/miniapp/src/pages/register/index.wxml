<view class="page" data-q62-miniapp-registration-page="true">
  <view class="summary">
    <view>
      <text class="eyebrow">主播注册</text>
      <text class="title">提交注册申请</text>
      <text class="summary-desc">{{sourceText}}</text>
    </view>
  </view>

  <view wx:if="{{error}}" class="error">
    <text>{{error}}</text>
  </view>

  <view class="form-card">
    <label class="field">
      <text>主播ID</text>
      <input value="{{form.anchorId}}" data-field="anchorId" bindinput="updateField" placeholder="请输入公司分配的主播ID" />
    </label>
    <label class="field">
      <text>主播姓名</text>
      <input value="{{form.displayName}}" data-field="displayName" bindinput="updateField" placeholder="请输入主播姓名或昵称" />
    </label>
    <label class="field">
      <text>手机号</text>
      <input value="{{form.mobile}}" data-field="mobile" bindinput="updateField" type="number" maxlength="11" placeholder="请输入本人手机号" />
    </label>
    <view class="privacy-note">注册阶段只用于确认主播ID和手机号，不收集平台账号、银行卡号或身份证号。提现前请在“打款信息”中补充实名、身份证和银行卡。</view>
    <checkbox-group class="field" bindchange="toggleProtocol">
      <text>协议确认</text>
      <label class="checkbox-line">
        <checkbox value="agreed" checked="{{form.protocolChecked}}" />
        <text class="hint" bindtap="openProtocols">已阅读并同意《用户服务协议》和《隐私政策》</text>
      </label>
    </checkbox-group>
    <view class="actions">
      <button class="primary" bindtap="submitRegistration" loading="{{submitting}}" disabled="{{submitting}}">提交申请</button>
      <button class="secondary" bindtap="refreshRegistrationStatus" loading="{{loadingStatus}}" disabled="{{loadingStatus}}">刷新状态</button>
      <button class="secondary" bindtap="goLogin">返回登录</button>
    </view>
  </view>

  <view wx:if="{{latestRequest}}" class="result-card">
    <text class="record-id">{{latestRequest.registrationId}}</text>
    <text class="badge {{latestRequest.reviewStatusTone}}">{{latestRequest.reviewStatusText}}</text>
    <text class="result-line">主播ID {{latestRequest.anchorId || '-'}} · {{latestRequest.mobile}}</text>
    <text class="helper-text">{{latestRequest.nextStepText}}</text>
  </view>
</view>
