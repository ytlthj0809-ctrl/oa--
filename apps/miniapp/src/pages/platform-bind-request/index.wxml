<view class="page">
  <view class="summary">
    <text class="eyebrow">平台账号</text>
    <text class="title">追加绑定申请</text>
  </view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view class="card">
    <label class="field"><text>平台</text><input value="{{form.platform}}" data-field="platform" bindinput="updateField" /></label>
    <label class="field"><text>平台 ID</text><input value="{{form.accountNo}}" data-field="accountNo" bindinput="updateField" /></label>
    <button class="primary" bindtap="submitRequest" loading="{{submitting}}" disabled="{{submitting}}">提交申请</button>
  </view>
  <view wx:if="{{result}}" class="card">
    <text class="status">{{result.requestId}}</text>
    <text class="meta">{{result.reviewStatus || result.status}}</text>
  </view>
</view>
