<view class="page">
  <view class="summary">
    <text class="eyebrow">提现前置校验</text>
    <text class="title">{{guide.title}}</text>
  </view>
  <view class="card">
    <text>{{guide.detail}}</text>
    <view class="actions">
      <button class="primary" bindtap="goAction">{{guide.actionText}}</button>
      <button class="secondary" bindtap="goWithdraw">返回提现</button>
    </view>
  </view>

  <view class="card rule-guide" data-q121-miniapp-withdraw-guide-rules="true">
    <view class="rule-guide-head">
      <text class="eyebrow">审核展示规则</text>
      <text class="title">提现规则</text>
    </view>
    <view class="rule-guide-list">
      <view wx:for="{{ruleSections}}" wx:key="title" class="rule-guide-item">
        <text class="rule-guide-title">{{item.title}}</text>
        <text class="rule-guide-detail">{{item.detail}}</text>
      </view>
    </view>
  </view>
</view>
