<view class="page" data-q70-miniapp-payment-info-page="true">
  <view class="summary">
    <view>
      <text class="eyebrow">打款信息</text>
      <text class="title">实名与银行卡</text>
    </view>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{loading}}" class="card page-loading">加载中</view>

  <view wx:if="{{paymentInfo}}" class="card">
    <view class="section-head">
      <text class="label">资料状态</text>
      <text class="badge {{paymentInfo.paymentInfoStatusTone}}">{{paymentInfo.paymentInfoStatusText}}</text>
    </view>
    <text class="badge {{paymentInfo.signStatusTone}}">{{paymentInfo.signStatusText}}</text>
    <view class="grid">
      <view class="metric">
        <text class="label">姓名</text>
        <text>{{paymentInfo.realNameMasked || '-'}}</text>
      </view>
      <view class="metric">
        <text class="label">银行卡</text>
        <text>{{paymentInfo.bankCardNoMasked || '-'}}</text>
      </view>
    </view>
  </view>

  <view class="card">
    <text class="label">办理入口</text>
    <text class="meta">首次填写与修改申请分开处理，避免误提交。</text>
    <view class="actions">
      <button wx:if="{{canCreatePaymentInfo}}" class="primary" bindtap="openForm">首次填写</button>
      <button wx:else class="secondary" disabled>资料已提交</button>
      <button class="secondary" bindtap="openChange">申请修改</button>
    </view>
  </view>

  <view class="card">
    <text class="label">修改申请</text>
    <view wx:if="{{changeRequests.length === 0}}" class="empty">暂无申请</view>
    <view wx:for="{{changeRequests}}" wx:key="changeRequestId" class="list-item">
      <text class="row-title">{{item.changeRequestId}}</text>
      <text class="badge {{item.reviewStatusTone}}">{{item.reviewStatusText}}</text>
      <text class="row-subtitle">需重签 {{item.requireResignText}}</text>
    </view>
  </view>
</view>
