<view class="page">
  <view class="summary login-hero">
    <image class="brand-logo" src="../../assets/brand/jiayin-logo-horizontal-official.png" mode="aspectFit" />
    <text class="eyebrow">主播账户</text>
    <text class="title">欢迎回到嘉音提现</text>
    <text class="meta">旧手机号、主播编号或平台账号均可登录，余额与提现记录已同步。</text>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view class="card login-card">
    <label class="field">
      <text>手机号/账号</text>
      <input value="{{form.mobile}}" data-field="mobile" bindinput="updateField" placeholder="请输入手机号或账号" />
    </label>
    <label class="field">
      <text>密码</text>
      <input password value="{{form.password}}" data-field="password" bindinput="updateField" placeholder="请输入密码" />
    </label>
    <button class="primary" bindtap="submitLogin" loading="{{submitting}}" disabled="{{submitting}}">登录</button>
    <view class="actions">
      <button class="secondary" bindtap="goRegister">注册</button>
      <button class="secondary" bindtap="openProtocols">协议隐私</button>
      <button class="secondary" bindtap="openContact">联系客服</button>
    </view>
    <text class="login-note">首次迁移登录请使用旧系统手机号或主播编号。</text>
  </view>

  <view class="card review-card" data-q124-miniapp-review-login="true">
    <view class="review-head">
      <text class="review-title">微信审核体验</text>
      <text class="review-badge">完整流程</text>
    </view>
    <text class="review-desc">用于版本审核完整体验：首页、余额、提现、签约、资料、记录均可查看，所有操作为受控演示，不产生真实打款。</text>
    <view class="review-account">
      <view class="review-row">
        <text class="review-label">账号</text>
        <text class="review-value">{{reviewAccount.account}}</text>
      </view>
      <view class="review-row">
        <text class="review-label">手机号</text>
        <text class="review-value">{{reviewAccount.mobile}}</text>
      </view>
      <view class="review-row">
        <text class="review-label">密码</text>
        <text class="review-value">{{reviewAccount.password}}</text>
      </view>
    </view>
    <view class="review-actions">
      <button class="secondary" bindtap="fillReviewAccount" disabled="{{submitting}}">填入审核账号</button>
      <button class="primary review-login" bindtap="submitReviewLogin" loading="{{submitting}}" disabled="{{submitting}}">审核体验登录</button>
    </view>
  </view>
</view>
