<view class="page">
  <view class="summary login-hero">
    <image class="brand-logo" src="../../assets/brand/jiayin-logo-horizontal-official.png" mode="aspectFit" />
    <text class="eyebrow">主播账户</text>
    <text class="title">欢迎回来</text>
    <text class="meta">使用微信快速登录嘉音提现。</text>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view class="card wechat-login-card" data-q124-miniapp-formal-login="true">
    <text class="wechat-title">微信快速登录</text>
    <text class="wechat-desc">已绑定账号会直接进入。</text>
    <button class="primary wechat-login" bindtap="loginByWechat" loading="{{wechatSubmitting}}" disabled="{{wechatSubmitting || submitting}}">微信一键登录</button>
    <view class="privacy-entry">
      <text>登录或提交资料前，请先阅读</text>
      <text class="privacy-link" bindtap="openPrivacyContract">《小程序用户隐私保护指引》</text>
    </view>
    <view wx:if="{{wechatBindingPending}}" class="binding-choice">
      <text class="binding-title">这个微信还没有绑定主播账号</text>
      <view class="binding-actions">
        <button class="secondary" bindtap="openLegacyLogin">我是旧主播</button>
        <button class="secondary" bindtap="goRegister">我是新主播</button>
      </view>
    </view>
  </view>

  <view class="card login-card">
    <view class="section-head" bindtap="toggleLegacyLogin">
      <text class="label" style="font-size: 28rpx;">旧主播账号登录</text>
      <text class="collapse-toggle">{{legacyLoginExpanded ? '收起' : '展开'}}</text>
    </view>
    <view wx:if="{{legacyLoginExpanded}}">
      <text wx:if="{{wechatBindingPending}}" class="binding-hint">登录成功后会自动绑定当前微信。</text>
      <label class="field">
        <text>旧账号</text>
        <input value="{{form.mobile}}" data-field="mobile" bindinput="updateField" placeholder="手机号、主播编号或平台账号" />
      </label>
      <label class="field">
        <view class="field-head">
          <text>密码</text>
        </view>
        <input password="{{!passwordVisible}}" value="{{form.password}}" data-field="password" bindinput="updateField" placeholder="请输入密码" />
      </label>
      <view class="actions" style="margin-top: 4rpx; margin-bottom: 12rpx;">
        <text class="collapse-toggle" bindtap="togglePasswordVisibility">{{passwordVisible ? '隐藏密码' : '显示密码'}}</text>
      </view>
      <text wx:if="{{cooldownText}}" class="login-cooldown">{{cooldownText}}</text>
      <button class="primary" bindtap="loginWithCurrentForm" loading="{{submitting}}" disabled="{{submitting || cooldownText || !form.mobile || !form.password}}">登录{{wechatBindingPending ? '并绑定微信' : ''}}</button>
    </view>
  </view>

  <view class="login-footer">
    <text bindtap="goRegister">新主播注册</text>
    <text bindtap="openProtocols">协议与隐私</text>
  </view>
</view>
