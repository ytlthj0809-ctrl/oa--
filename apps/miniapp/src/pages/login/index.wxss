@import "../../styles/common.wxss";

.login-hero {
  padding-bottom: 30rpx;
}

.login-card {
  margin-top: 8rpx;
}

.login-card .primary {
  margin-top: 10rpx;
}

.login-cooldown {
  color: #b54708;
  display: block;
  font-size: 24rpx;
  line-height: 1.45;
  margin: 8rpx 0 14rpx;
  text-align: center;
}

.wechat-login-card {
  border-color: #f4d33f;
  margin-top: 24rpx;
}

.wechat-title {
  color: #22130f;
  display: block;
  font-size: 32rpx;
  font-weight: 800;
}

.wechat-desc {
  color: #5f5a52;
  display: block;
  font-size: 25rpx;
  line-height: 1.55;
  margin-top: 16rpx;
}

.wechat-login {
  margin-top: 18rpx;
  background: #ffda01;
  color: #22130f;
}

.privacy-entry {
  color: #675f53;
  font-size: 24rpx;
  line-height: 1.55;
  margin-top: 18rpx;
  text-align: center;
}

.privacy-entry text {
  display: inline;
}

.privacy-link {
  text-decoration: underline;
}

.binding-choice {
  border-top: 1rpx solid #eee5c8;
  margin-top: 24rpx;
  padding-top: 22rpx;
}

.binding-title,
.binding-hint {
  color: #5f5543;
  display: block;
  font-size: 24rpx;
  line-height: 1.5;
}

.binding-actions {
  display: grid;
  gap: 14rpx;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin-top: 16rpx;
}

.binding-actions button {
  margin: 0;
  min-width: 0;
}

.binding-hint {
  color: #806200;
  margin-bottom: 18rpx;
}

.login-footer {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx 30rpx;
  justify-content: center;
  padding: 28rpx 16rpx 12rpx;
}

.login-footer text {
  color: #675f53;
  font-size: 24rpx;
  text-decoration: underline;
}
