<view class="page">
  <view class="summary">
    <text class="eyebrow">通知</text>
    <text class="title">通知详情</text>
  </view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{loading}}" class="card page-loading">加载中</view>
  <view wx:if="{{!loading && !notification}}" class="card empty">通知不存在或已失效</view>
  <view wx:if="{{notification}}" class="card">
    <view class="section-head">
      <text class="row-title">{{notification.noticeTitle}}</text>
      <text class="badge {{notification.readStatusTone}}">{{notification.readStatusText}}</text>
    </view>
    <text class="meta">{{notification.noticeTypeText}}</text>
    <text>{{notification.body}}</text>
    <button class="secondary" bindtap="openBusiness">查看关联业务</button>
  </view>
</view>
