<view class="page">
  <view class="summary">
    <text class="eyebrow">通知</text>
    <text class="title">通知详情</text>
  </view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{!notification}}" class="card empty">通知不存在或已失效</view>
  <view wx:else class="card">
    <text class="status">{{notification.noticeTitle}}</text>
    <text class="meta">{{notification.noticeType}} · {{notification.readStatus}}</text>
    <text>{{notification.body}}</text>
    <button class="secondary" bindtap="openBusiness">查看关联业务</button>
  </view>
</view>
