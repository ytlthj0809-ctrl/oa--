<view class="page" data-q70-miniapp-data-page="true">
  <view class="summary">
    <view>
      <text class="eyebrow">数据</text>
      <text class="title">月度收入与任务</text>
    </view>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view class="segment-control">
    <text class="segment-tab {{activeSegment === 'monthly' ? 'active' : ''}}" bindtap="switchSegment" data-segment="monthly">月度数据</text>
    <text class="segment-tab {{activeSegment === 'flows' ? 'active' : ''}}" bindtap="switchSegment" data-segment="flows">余额明细</text>
    <text class="segment-tab {{activeSegment === 'rewards' ? 'active' : ''}}" bindtap="switchSegment" data-segment="rewards">任务奖励</text>
  </view>

  <!-- Monthly data segment -->
  <view wx:if="{{activeSegment === 'monthly'}}">
    <view class="card">
      <label class="field">
        <text>月份</text>
        <picker mode="date" fields="month" value="{{month}}" end="{{currentChinaMonth}}" bindchange="changeMonth">
          <view class="picker-value">{{month}}</view>
        </picker>
      </label>
      <button class="primary" bindtap="loadData" loading="{{loading}}" disabled="{{loading}}">刷新数据</button>
    </view>

    <view wx:if="{{loading}}" class="card page-loading">加载中</view>
    <view wx:if="{{!loading && snapshots.length === 0}}" class="card empty">暂无数据</view>
    <view wx:for="{{snapshots}}" wx:key="snapshotId" class="card" hover-class="tap-target-hover" bindtap="goPage" data-page="data-detail" data-month="{{item.month}}" data-platform="{{item.platform}}">
      <text class="status">{{item.month}} · {{item.platform}}</text>
      <view class="grid">
        <view class="metric">
          <text class="label">流水</text>
          <text class="value">{{item.incomeText}}</text>
        </view>
        <view class="metric">
          <text class="label">有效时长</text>
          <text class="value">{{item.durationText}}</text>
        </view>
        <view class="metric">
          <text class="label">有效天数</text>
          <text class="value">{{item.validDays}}</text>
        </view>
        <view class="metric">
          <text class="label">任务状态</text>
          <text class="badge {{item.taskStatusTone}}">{{item.taskStatusText}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Balance flows segment -->
  <view wx:if="{{activeSegment === 'flows'}}">
    <view wx:if="{{loading}}" class="card page-loading">加载中</view>
    <view wx:if="{{!loading && flows.length === 0}}" class="card empty">暂无余额流水</view>
    <view wx:for="{{flows}}" wx:key="flowId" class="card">
      <view class="section-head">
        <text class="row-title">{{item.directionText}} · {{item.amountText}}</text>
        <text class="badge {{item.statusTone}}">{{item.statusText}}</text>
      </view>
      <text class="meta">{{item.flowTypeText}}{{item.createdAtText ? ' · ' + item.createdAtText : ''}}</text>
    </view>
    <button wx:if="{{flowHasMore}}" class="secondary" bindtap="loadMoreFlows" loading="{{loadingMoreFlows}}" disabled="{{loadingMoreFlows}}">
      查看更多（已加载 {{flows.length}} 条）
    </button>
  </view>

  <!-- Rewards segment -->
  <view wx:if="{{activeSegment === 'rewards'}}">
    <view wx:if="{{loading}}" class="card page-loading">加载中</view>
    <view wx:if="{{!loading && rewards.length === 0}}" class="card empty">暂无任务奖励</view>
    <view wx:for="{{rewards}}" wx:key="rewardResultId" class="card">
      <view class="section-head">
        <text class="row-title">{{item.ruleCodeLabelText || item.ruleCode || item.metricCode}}</text>
        <text class="badge {{item.statusTone}}">{{item.statusText}}</text>
      </view>
      <text class="meta">{{item.rewardText}}</text>
    </view>
    <button wx:if="{{rewardHasMore}}" class="secondary" bindtap="loadMoreRewards" loading="{{loadingMoreRewards}}" disabled="{{loadingMoreRewards}}">
      查看更多（已加载 {{rewards.length}} 条）
    </button>
  </view>
</view>
