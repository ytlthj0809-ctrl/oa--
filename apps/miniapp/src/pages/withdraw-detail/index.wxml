<view class="page">
  <view class="summary">
    <text class="eyebrow">提现</text>
    <text class="title">提现记录详情</text>
  </view>
  <view wx:if="{{error}}" class="error">
    <text>{{error}}</text>
    <button class="secondary small" bindtap="goRecords">返回提现记录</button>
  </view>
  <view wx:if="{{loading}}" class="card page-loading">加载中</view>
  <view wx:if="{{detail}}" class="card">
    <view class="section-head">
      <text class="row-title">{{detail.applyId}}</text>
      <text class="badge {{detail.displayStatusTone}}">{{detail.displayStatusText}}</text>
    </view>
    <view class="grid">
      <view class="metric">
        <text class="label">提现金额</text>
        <text class="value">{{detail.amountText}}</text>
      </view>
      <view class="metric">
        <text class="label">冻结金额</text>
        <text class="value">{{detail.frozenAmountText}}</text>
      </view>
      <view class="metric">
        <text class="label">处理批次</text>
        <text>{{detail.batchId || '-'}}</text>
      </view>
      <view class="metric">
        <text class="label">提交时间</text>
        <text>{{detail.createdAtText || '-'}}</text>
      </view>
    </view>
  </view>
  <view wx:if="{{detail}}" class="card">
    <text class="label">处理进度</text>
    <view class="withdraw-progress detail-progress" aria-label="提现处理进度">
      <view
        wx:for="{{detail.progressSteps}}"
        wx:for-item="step"
        wx:key="key"
        class="progress-step {{step.done ? 'done' : ''}} {{step.current ? 'current' : ''}} {{step.failed ? 'failed' : ''}}"
      >
        <text class="progress-dot">{{step.index}}</text>
        <text>{{step.label}}</text>
      </view>
    </view>
    <text class="progress-summary">{{detail.progressSummaryText}}</text>
  </view>
  <view wx:if="{{detail}}" class="card">
    <text class="label">状态轨迹</text>
    <view wx:if="{{detail.statusHistory.length > 0}}" class="timeline">
      <view wx:for="{{detail.statusHistory}}" wx:key="sequence" class="timeline-item">
        <view class="timeline-dot {{index === 0 ? 'active' : ''}}"></view>
        <view class="timeline-body">
          <text>{{item.statusText}}</text>
          <text wx:if="{{item.createdAtText}}" class="timeline-time">{{item.createdAtText}}</text>
          <text wx:if="{{item.reason}}" class="timeline-reason">{{item.reason}}</text>
        </view>
      </view>
    </view>
    <view wx:else class="empty">暂无状态更新</view>
  </view>
  <view wx:if="{{detail && isRejected}}" class="card">
    <text class="label">操作</text>
    <view class="actions">
      <button class="primary" bindtap="resubmit">重新提交</button>
      <button class="secondary" bindtap="openContact">联系客服</button>
    </view>
  </view>
</view>
