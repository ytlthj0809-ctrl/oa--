<view class="page">
  <view class="summary">
    <text class="eyebrow">我的</text>
    <text class="title">个人资料</text>
  </view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{profile}}" class="card">
    <view class="list-item"><text class="label">主播姓名</text><text>{{profile.displayName || '-'}}</text></view>
    <view class="list-item"><text class="label">主播状态</text><text>{{profile.anchorStatus || '-'}}</text></view>
    <view class="list-item"><text class="label">手机号</text><text>{{profile.mobileMasked || '-'}}</text></view>
    <view class="list-item"><text class="label">经纪人</text><text>{{profile.managerName || '-'}}</text></view>
    <view class="list-item"><text class="label">注册时间</text><text>{{profile.registeredAt || '-'}}</text></view>
  </view>
  <view wx:if="{{legacy}}" class="card">
    <text class="label">旧系统历史摘要</text>
    <text>旧提现 {{legacy.oldWithdrawCount}} 条 · 旧余额流水 {{legacy.oldBalanceFlowCount}} 条</text>
  </view>
</view>
