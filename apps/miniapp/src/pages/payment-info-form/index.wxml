<view class="page">
  <view class="summary">
    <text class="eyebrow">打款信息</text>
    <text class="title">首次填写</text>
  </view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view class="notice">打款信息仅用于云账户签约核验和线下打款登记，提交后页面会脱敏展示。注册主播时不会要求填写银行卡。</view>
  <view wx:if="{{saved}}" class="success-card">
    <text>保存成功</text>
    <text class="helper-text">下一步请完成云账户签约；签约完成后即可回到提现页提交申请。</text>
    <view class="actions">
      <button class="primary" bindtap="goSign">去签约</button>
      <button class="secondary" bindtap="goPaymentInfo">查看打款信息</button>
    </view>
  </view>
  <view class="card">
    <label class="field {{fieldTones.realName || ''}}">
      <text>姓名</text>
      <input value="{{form.realName}}" data-field="realName" bindinput="updateField" bindblur="validateField" placeholder="请输入真实姓名" />
      <text wx:if="{{fieldErrors.realName}}" class="field-error-hint">{{fieldErrors.realName}}</text>
    </label>
    <label class="field {{fieldTones.idCardNo || ''}}">
      <text>身份证号</text>
      <input type="idcard" maxlength="18" value="{{form.idCardNo}}" data-field="idCardNo" bindinput="updateField" bindblur="validateField" placeholder="请输入 18 位身份证号" />
      <text wx:if="{{fieldErrors.idCardNo}}" class="field-error-hint">{{fieldErrors.idCardNo}}</text>
    </label>
    <label class="field {{fieldTones.paymentMobile || ''}}">
      <text>手机号</text>
      <input type="number" maxlength="11" value="{{form.paymentMobile}}" data-field="paymentMobile" bindinput="updateField" bindblur="validateField" placeholder="请输入收款手机号" />
      <text wx:if="{{fieldErrors.paymentMobile}}" class="field-error-hint">{{fieldErrors.paymentMobile}}</text>
    </label>
    <label class="field {{fieldTones.bankCardNo || ''}}">
      <text>银行卡号</text>
      <input type="number" maxlength="19" value="{{form.bankCardNo}}" data-field="bankCardNo" bindinput="updateField" bindblur="validateField" placeholder="请输入本人银行卡号" />
      <text wx:if="{{fieldErrors.bankCardNo}}" class="field-error-hint">{{fieldErrors.bankCardNo}}</text>
    </label>
    <button class="primary" bindtap="submitForm" loading="{{submitting}}" disabled="{{submitting}}">保存</button>
  </view>
</view>
