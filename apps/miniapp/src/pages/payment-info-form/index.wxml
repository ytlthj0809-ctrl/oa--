<view class="page">
  <view class="summary">
    <text class="eyebrow">打款信息</text>
    <text class="title">首次填写</text>
  </view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{saved}}" class="card status">保存成功</view>
  <view class="card">
    <label class="field"><text>姓名</text><input value="{{form.realName}}" data-field="realName" bindinput="updateField" /></label>
    <label class="field"><text>身份证号</text><input value="{{form.idCardNo}}" data-field="idCardNo" bindinput="updateField" /></label>
    <label class="field"><text>手机号</text><input value="{{form.paymentMobile}}" data-field="paymentMobile" bindinput="updateField" /></label>
    <label class="field"><text>银行卡号</text><input value="{{form.bankCardNo}}" data-field="bankCardNo" bindinput="updateField" /></label>
    <button class="primary" bindtap="submitForm" loading="{{submitting}}" disabled="{{submitting}}">保存</button>
  </view>
</view>
