.page {
  background: linear-gradient(180deg, #231815 0rpx, #231815 248rpx, #f4f6f8 248rpx, #f4f6f8 100%);
  color: #231815;
  min-height: 100vh;
  padding: 28rpx 28rpx calc(36rpx + env(safe-area-inset-bottom));
}

.summary,
.card,
.list-item {
  background: #ffffff;
  border: 1rpx solid #d9dee8;
  border-top: 8rpx solid #ffda01;
  border-radius: 16rpx;
  box-shadow: 0 14rpx 34rpx rgba(35, 24, 21, 0.08);
  margin-bottom: 20rpx;
  min-width: 0;
  padding: 24rpx;
}

.summary {
  display: grid;
  gap: 16rpx;
}

.eyebrow,
.label,
.meta {
  color: #667085;
  display: block;
  font-size: 24rpx;
}

.title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  margin-top: 8rpx;
}

.brand-logo {
  display: block;
  height: 76rpx;
  margin-bottom: 16rpx;
  width: 236rpx;
}

.brand-mark {
  display: block;
  height: 72rpx;
  width: 82rpx;
}

.grid {
  display: grid;
  gap: 16rpx;
  grid-template-columns: 1fr 1fr;
}

.metric {
  background: #fffdf3;
  border: 1rpx solid #e4e7ec;
  border-radius: 14rpx;
  box-shadow: 0 1rpx 0 rgba(35, 24, 21, 0.03);
  min-height: 116rpx;
  padding: 18rpx;
}

.metric text {
  display: block;
  overflow-wrap: anywhere;
}

.value {
  color: #231815;
  font-size: 30rpx;
  font-weight: 700;
  margin-top: 6rpx;
}

.primary,
.secondary {
  align-items: center;
  display: flex;
  justify-content: center;
  line-height: 1.25;
  min-height: 76rpx;
  min-width: 0;
  padding: 0 20rpx;
  white-space: normal;
}

.primary::after,
.secondary::after,
button::after {
  border: 0;
}

.primary {
  background: #ffda01;
  border-radius: 14rpx;
  box-shadow: 0 8rpx 18rpx rgba(255, 218, 1, 0.22);
  color: #231815;
  font-size: 26rpx;
  font-weight: 700;
}

.secondary {
  background: #eef2f6;
  border-radius: 14rpx;
  color: #231815;
  font-size: 24rpx;
  font-weight: 700;
}

.danger {
  background: #fbe9e7;
  color: #b5473b;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.actions button {
  flex: 1 1 220rpx;
}

.error {
  background: #fbe9e7;
  border: 1rpx solid #f2b8b0;
  border-radius: 14rpx;
  color: #b5473b;
  margin-bottom: 20rpx;
  padding: 18rpx;
  overflow-wrap: anywhere;
}

.field {
  display: grid;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.field input,
.field textarea {
  background: #ffffff;
  border: 1rpx solid #d9dee8;
  border-radius: 14rpx;
  min-height: 72rpx;
  padding: 0 16rpx;
}

.field textarea {
  min-height: 120rpx;
  padding: 16rpx;
}

.status {
  color: #1d7f5d;
  font-size: 24rpx;
  font-weight: 700;
}

.badge {
  align-items: center;
  border-radius: 999rpx;
  display: inline-flex;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.2;
  min-height: 44rpx;
  padding: 0 18rpx;
  max-width: 100%;
}

.badge.success {
  background: #e8f6ee;
  color: #1d7f5d;
}

.badge.pending {
  background: #fff6d7;
  color: #9a6a00;
}

.badge.danger {
  background: #fbe9e7;
  color: #b5473b;
}

.badge.neutral {
  background: #eef2f6;
  color: #475467;
}

.helper-text {
  color: #667085;
  display: block;
  font-size: 24rpx;
  line-height: 1.55;
  margin-top: 12rpx;
}

.notice {
  background: #fffbea;
  border: 1rpx solid #ffe58a;
  border-radius: 14rpx;
  color: #6f5200;
  font-size: 24rpx;
  line-height: 1.55;
  margin-bottom: 20rpx;
  padding: 18rpx;
}

.success-card {
  background: #e8f6ee;
  border: 1rpx solid #b9e7c9;
  border-radius: 14rpx;
  color: #1d7f5d;
  margin-bottom: 20rpx;
  padding: 18rpx;
}

.page-loading {
  animation: skeletonPulse 1.2s ease-in-out infinite;
  background: linear-gradient(90deg, #f2f4f7 0%, #ffffff 48%, #f2f4f7 100%);
  color: #667085;
  min-height: 112rpx;
  text-align: center;
}

@keyframes skeletonPulse {
  0% {
    opacity: 0.72;
  }

  50% {
    opacity: 1;
  }

  100% {
    opacity: 0.72;
  }
}

.tap-target-hover {
  opacity: 0.82;
  transform: scale(0.992);
}

.row-title {
  color: #231815;
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  overflow-wrap: anywhere;
}

.row-subtitle {
  color: #667085;
  display: block;
  font-size: 24rpx;
  line-height: 1.45;
  margin-top: 8rpx;
  overflow-wrap: anywhere;
}

.section-head {
  align-items: center;
  display: flex;
  gap: 16rpx;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-head .label {
  color: #231815;
  font-size: 30rpx;
  font-weight: 700;
}

.section-head .badge {
  flex: 0 0 auto;
}

.empty {
  align-items: center;
  background: #fbfcfd;
  border: 1rpx dashed #cbd5dc;
  border-radius: 14rpx;
  color: #667085;
  display: flex;
  justify-content: center;
  min-height: 96rpx;
  padding: 20rpx;
  text-align: center;
}
