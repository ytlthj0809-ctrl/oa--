APP_ENV=development
HOST=127.0.0.1
PORT=8787
DATABASE_URL=mysql://user:password@127.0.0.1:3306/jiayin_oa
DB_POOL_SIZE=10

# 仅首次初始化时短暂设置，初始化完成后删除。
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
# 正式部署可改为只注入 scrypt 哈希，避免明文密码进入服务器环境。
ADMIN_BOOTSTRAP_PASSWORD_HASH=

MINIAPP_WECHAT_APP_ID_REF=/absolute/path/to/miniapp-app-id
MINIAPP_WECHAT_APP_SECRET_REF=/absolute/path/to/miniapp-app-secret

COS_BUCKET=
COS_REGION=
COS_SECRET_REF=/absolute/path/to/cos.env

YZH_REAL_SIGNING_ENABLED=false
YZH_DEALER_ID=
YZH_BROKER_ID=
YZH_APP_KEY_REF=/absolute/path/to/yzh.env
YZH_3DES_KEY_REF=/absolute/path/to/yzh.env
YZH_PRIVATE_KEY_REF=/absolute/path/to/yzh-private.pem
YZH_PUBLIC_KEY_REF=/absolute/path/to/yzh-public.pem
YZH_CALLBACK_URL=https://api.jiayin.site/api/callback/yzh/sign
YZH_SIGN_RETURN_URL=weixin://miniapp/yzh-sign-return
